# Copy to .env.local for `npm run dev` and builds. Both values are public: they
# are inlined into the browser bundle. Find them under Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://qhjysorczroizpgmagpp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: server only, never prefix with NEXT_PUBLIC_. Needed for inviting
# members and sending set-password links. The secret key (sb_secret_...) from
# Project Settings -> API Keys, not the legacy service_role key. In production,
# set it as a Worker secret: `npx wrangler secret put SUPABASE_SECRET_KEY`.
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=