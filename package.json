{
  "name": "headless-form-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prebuild": "npm run build:embed",
    "build": "next build",
    "predev": "npm run build:embed",
    "dev": "next dev",
    "start": "next start",
    "build:embed": "node embed/build.mts",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy --use-api",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/tiptap": "^9.6.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tabler/icons-react": "^3.48.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "survey-core": "^3.1.2",
    "survey-creator-core": "^3.1.2",
    "survey-creator-react": "^3.1.2",
    "survey-react-ui": "^3.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@electric-sql/pglite": "0.5.8",
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "supabase": "^2.119.0",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.28.2": true
  }
}
